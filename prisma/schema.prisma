// Bedlay Gardens Kennels — Prisma schema
// See PRD-bedlay-gardens-website.md §9 (core) and §13.4 (extended features)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum PricingModel {
  PER_NIGHT
  PER_DAY
  PER_SESSION
}

// When the customer pays for a service, configured per-service by admins.
enum PaymentTiming {
  FULL_UPFRONT // 100% at booking time
  DEPOSIT_THEN_BALANCE // deposit at booking, balance before check-in
  INVOICE_AFTER // confirmed without payment; invoiced at check-out
}

enum VaccinationStatus {
  UNVERIFIED
  VERIFIED
  EXPIRED
}

enum DaycareDuration {
  FULL_DAY
  HALF_DAY
}

enum DaycareHalfDaySlot {
  AM
  PM
}

enum DogSize {
  MINIATURE
  SMALL
  MEDIUM
  LARGE
  GIANT
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_ADMIN
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  BALANCE
  INVOICE
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum VanRunStopStatus {
  PENDING
  COLLECTED
  WALKED
  DROPPED_OFF
}

enum CareTaskType {
  FEED
  MEDICATION
  WALK
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  EMBED
}

enum MediaUsage {
  GALLERY
  HERO
  SERVICE
  ABOUT
  PUPDATE
}

enum TrialOutcome {
  PASSED
  RETRY
  NOT_SUITABLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DogFlagType {
  NOT_DOG_SOCIABLE
  NO_SHARED_KENNEL
  NO_GROUP_WALKS
  RESOURCE_GUARDING
  ESCAPE_RISK
  SOLO_MANAGED_BOARDING
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CLAIMED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
  NONE
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  customerNumber   Int       @unique @default(autoincrement())
  emailVerified    DateTime?
  passwordHash     String?
  name             String
  phone            String?
  workPhone        String?
  addressLine1     String?
  addressLine2     String?
  addressCity      String?
  addressPostcode  String?
  role             Role      @default(CUSTOMER)
  isSuperAdmin     Boolean   @default(false)
  active           Boolean   @default(true)
  photoUrl         String?
  jobTitle         String?
  bio              String?
  stripeCustomerId String?
  adminNotes       String?
  createdAt        DateTime  @default(now())

  // Vet practice and emergency contact — account-level (shared across all of
  // this customer's dogs), set on the portal "Your Details" page.
  vetName                      String?
  vetPhone                     String?
  vetPracticeName              String?
  vetAddressLine1              String?
  vetAddressLine2              String?
  vetCity                      String?
  vetPostcode                  String?
  vetEmail                     String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactAddressLine1 String?
  emergencyContactAddressLine2 String?
  emergencyContactCity         String?
  emergencyContactPostcode     String?

  accounts               Account[]
  sessions               Session[]
  dogs                   Dog[]
  bookings               Booking[]
  contactMessages        ContactMessage[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  verifiedVaccinations   VaccinationRecord[]     @relation("VaccinationVerifier")
  vanRuns                VanRun[]
  completedCareTasks     CareTask[]              @relation("CareTaskCompletedBy")
  incidentReports        IncidentReport[]        @relation("IncidentReportedBy")
  subscriptions          Subscription[]
  waitlistEntries        WaitlistEntry[]
  reviews                Review[]
  purchasedVouchers      Voucher[]               @relation("VoucherPurchaser")
  creditLedgerEntries    CreditLedger[]
  signedAgreements       SignedAgreement[]
  notificationPreference NotificationPreference?
  messageLogs            MessageLog[]
  passwordResetTokens    PasswordResetToken[]
  toDoTasksAssigned      ToDoTask[]              @relation("ToDoAssignee")
  toDoTasksCreated       ToDoTask[]              @relation("ToDoCreatedBy")
  assignedBookings       Booking[]               @relation("BookingAssignedStaff")

  @@index([role])
}

// Auth.js (NextAuth) required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Self-service "forgot password" — separate from VerificationToken (which
// Auth.js/Resend owns for magic-link sign-in) so this has its own lifecycle:
// single-use (usedAt), a short expiry, and a direct User relation rather
// than being keyed by email string. Works for any account regardless of
// whether it already has a password, so it also covers the case of an
// account that's only ever signed in via magic link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Service {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String
  pricingModel      PricingModel
  basePricePence    Int
  // Only used for the daycare service's half-day option; null elsewhere.
  halfDayPricePence Int?
  paymentTiming     PaymentTiming @default(DEPOSIT_THEN_BALANCE)
  active            Boolean       @default(true)
  sortOrder         Int           @default(0)
  requiresTrial     Boolean       @default(false)

  bookings        Booking[]
  addons          Addon[]
  priceRules      PriceRule[]
  subscriptions   Subscription[]
  waitlistEntries WaitlistEntry[]
}

model Dog {
  id               String    @id @default(cuid())
  dogNumber        Int       @unique @default(autoincrement())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  breed            String
  dob              DateTime?
  sex              String?
  size             DogSize?
  neutered         Boolean   @default(false)
  weightKg         Float?
  photoUrl         String?
  feedingNotes     String?
  medicationNotes  String?
  behaviourNotes   String?
  allergies        String?
  medicalHistorySummary String?
  microchipNumber  String?
  color            String?
  runType          String?
  temperament      String?
  groupPlayApproved Boolean  @default(false)
  createdAt        DateTime  @default(now())

  vaccinationRecords VaccinationRecord[]
  bookingDogs        BookingDog[]
  walkBookings       WalkBooking[]
  vanRunStops        VanRunStop[]
  careTasks          CareTask[]
  incidentReports    IncidentReport[]
  flags              DogFlag[]
  pupdates           Pupdate[]
  subscriptions      Subscription[]
  waitlistEntries    WaitlistEntry[]
  trialVisits        TrialVisit[]
  medications        DogMedication[]
  feedingItems       DogFeedingItem[]

  @@index([ownerId])
}

// A single dosing line in a dog's medical history — a name/amount plus either
// a recurring AM/PM schedule or one specific time of day (mutually exclusive,
// enforced by the form UI, not the DB).
model DogMedication {
  id           String   @id @default(cuid())
  dogId        String
  dog          Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name         String
  amount       String?
  am           Boolean  @default(false)
  noon         Boolean  @default(false)
  pm           Boolean  @default(false)
  specificTime String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([dogId])
}

// A single feeding line — a food item/amount plus either a recurring AM/PM
// schedule or one specific time of day (mutually exclusive, enforced by the
// form UI, not the DB). Mirrors DogMedication.
model DogFeedingItem {
  id           String   @id @default(cuid())
  dogId        String
  dog          Dog      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  item         String
  amount       String?
  am           Boolean  @default(false)
  pm           Boolean  @default(false)
  specificTime String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([dogId])
}

model VaccinationRecord {
  id           String            @id @default(cuid())
  dogId        String
  dog          Dog               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type         String
  dateGiven    DateTime
  expiryDate   DateTime
  documentUrl  String?
  status       VaccinationStatus @default(UNVERIFIED)
  verifiedById String?
  verifiedBy   User?             @relation("VaccinationVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  @@index([dogId])
  @@index([expiryDate])
}

model KennelUnit {
  id          String  @id @default(cuid())
  name        String  @unique
  size        String
  dogCapacity Int     @default(1)
  active      Boolean @default(true)

  bookings     Booking[]
  blockedDates BlockedDate[]
  occupancies  KennelOccupancy[]
}

// One row per booked night per kennel unit. The unique constraint is what
// makes double-booking impossible under concurrent requests (PRD §10) —
// two transactions racing to book the same unit/night can't both insert.
model KennelOccupancy {
  id           String     @id @default(cuid())
  kennelUnitId String
  kennelUnit   KennelUnit @relation(fields: [kennelUnitId], references: [id])
  date         DateTime
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([kennelUnitId, date])
  @@index([bookingId])
}

model Booking {
  id                 String              @id @default(cuid())
  // Sequential, customer-facing reference (displayed as "Booking 001") —
  // same pattern as User.customerNumber/Dog.dogNumber, see the migration
  // that added those for the backfill approach this one mirrors.
  bookingNumber      Int                 @unique @default(autoincrement())
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id])
  serviceId          String
  service            Service             @relation(fields: [serviceId], references: [id])
  startDate          DateTime
  endDate            DateTime
  status             BookingStatus       @default(DRAFT)
  kennelUnitId       String?
  kennelUnit         KennelUnit?         @relation(fields: [kennelUnitId], references: [id])
  totalPence         Int
  depositPence       Int
  balanceDueDate     DateTime?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  // Only set for daycare bookings.
  daycareDuration    DaycareDuration?
  daycareHalfDaySlot DaycareHalfDaySlot?
  // Shared by every booking created together when a customer books several
  // Day Care dates in one pass — each date is still its own Booking row, this
  // just lets emails/UI find the sibling dates. Null for everything else.
  batchId            String?
  // Admin-set time-of-day ("HH:mm") and staff member for bookings that don't
  // otherwise carry scheduling info — e.g. Meet & Greet, Secure Forest Walks.
  // Dog Walking (Van Collection) bookings already get both from their
  // VanRun/VanRunStop instead; the admin Scheduled Services table falls back
  // to these fields only when there's no van run stop to read from.
  scheduledTime      String?
  assignedStaffId    String?
  assignedStaff      User?               @relation("BookingAssignedStaff", fields: [assignedStaffId], references: [id])

  bookingDogs       BookingDog[]
  bookingAddons     BookingAddon[]
  payments          Payment[]
  walkBookings      WalkBooking[]
  vanRunStops       VanRunStop[]
  careTasks         CareTask[]
  incidentReports   IncidentReport[]
  pupdates          Pupdate[]
  trialVisits       TrialVisit[]
  kennelOccupancies KennelOccupancy[]
  review            Review?

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([kennelUnitId, startDate, endDate])
  @@index([batchId])
  @@index([assignedStaffId])
}

model BookingDog {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dogId     String
  dog       Dog     @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@id([bookingId, dogId])
}

model Addon {
  id          String   @id @default(cuid())
  name        String
  description String?
  pricePence  Int
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  active      Boolean  @default(true)

  bookingAddons BookingAddon[]
}

model BookingAddon {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId    String
  addon      Addon   @relation(fields: [addonId], references: [id])
  quantity   Int     @default(1)
  pricePence Int

  @@index([bookingId])
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique
  hostedInvoiceUrl      String?
  type                  PaymentType
  amountPence           Int
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  succeededAt           DateTime?

  @@index([bookingId])
}

model WalkSlot {
  id          String   @id @default(cuid())
  date        DateTime
  time        String
  durationMin Int
  maxDogs     Int

  walkBookings WalkBooking[]
}

model WalkBooking {
  id         String   @id @default(cuid())
  walkSlotId String
  walkSlot   WalkSlot @relation(fields: [walkSlotId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  dogId      String
  dog        Dog      @relation(fields: [dogId], references: [id])

  @@index([walkSlotId])
}

model VanRun {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  startTime String
  maxDogs   Int
  staffId   String?
  staff     User?    @relation(fields: [staffId], references: [id])

  stops VanRunStop[]

  @@index([date])
}

model VanRunStop {
  id            String           @id @default(cuid())
  vanRunId      String
  vanRun        VanRun           @relation(fields: [vanRunId], references: [id], onDelete: Cascade)
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id])
  dogId         String
  dog           Dog              @relation(fields: [dogId], references: [id])
  pickupAddress String
  accessNotes   String?
  sortOrder     Int              @default(0)
  status        VanRunStopStatus @default(PENDING)
  collectedAt   DateTime?
  droppedOffAt  DateTime?

  @@index([vanRunId])
}

model CareTask {
  id            String       @id @default(cuid())
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dogId         String
  dog           Dog          @relation(fields: [dogId], references: [id])
  date          DateTime
  type          CareTaskType
  description   String
  completedById String?
  completedBy   User?        @relation("CareTaskCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  notes         String?

  @@index([bookingId])
  @@index([date])
}

// A general staff to-do list shown on the admin Daily Overview — not tied to
// a booking or date, just a running list optionally assigned to a staff
// member (distinct from CareTask, which is the per-dog, per-day feed /
// medication / walk checklist).
model ToDoTask {
  id           String    @id @default(cuid())
  text         String
  assignedToId String?
  assignedTo   User?     @relation("ToDoAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("ToDoCreatedBy", fields: [createdById], references: [id])
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([assignedToId])
  @@index([completed])
}

model IncidentReport {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dogId        String
  dog          Dog      @relation(fields: [dogId], references: [id])
  reportedById String
  reportedBy   User     @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  description  String
  severity     String
  createdAt    DateTime @default(now())

  @@index([dogId])
}

model BlockedDate {
  id           String      @id @default(cuid())
  date         DateTime
  kennelUnitId String?
  kennelUnit   KennelUnit? @relation(fields: [kennelUnitId], references: [id])
  reason       String?

  @@index([date])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model MediaItem {
  id                String           @id @default(cuid())
  type              MediaType
  url               String
  thumbnailUrl      String?
  caption           String?
  altText           String?
  // Freeform tag — for usage=SERVICE this holds the service's slug (matched
  // against Service.slug to pick that service's card photo), unrelated to
  // the admin-managed gallery categories below. Kept separate from
  // galleryCategoryId so neither use interferes with the other.
  category          String?
  galleryCategoryId String?
  galleryCategory   GalleryCategory? @relation(fields: [galleryCategoryId], references: [id], onDelete: SetNull)
  sortOrder         Int              @default(0)
  usage             MediaUsage
  createdAt         DateTime         @default(now())

  pupdates Pupdate[]
}

// Admin-managed filter categories for the public /gallery page (Admin ->
// Media -> Gallery Categories) — distinct from MediaItem.category, which is
// a different, unrelated freeform field used for service-page photo matching.
model GalleryCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)

  mediaItems MediaItem[]
}

model Testimonial {
  id      String  @id @default(cuid())
  author  String
  text    String
  visible Boolean @default(true)
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// Tracks which reminder emails have already gone out so daily cron jobs don't
// resend the same notification (bookingId/vaccinationRecordId + type is the
// dedupe key — no unique constraint since a booking can receive several
// distinct reminder types).
model EmailLog {
  id                  String   @id @default(cuid())
  type                String
  bookingId           String?
  vaccinationRecordId String?
  sentAt              DateTime @default(now())

  @@index([type, bookingId])
  @@index([type, vaccinationRecordId])
}

// Every email the app has ever attempted to send, written by sendEmail()
// itself — the one choke point every call site goes through — so this is
// complete without having to instrument each caller individually. `to` is
// a plain string rather than a User relation since some recipients aren't
// customers at all (the business inbox, a voucher sent to a non-account
// email). Feeds the admin "Sent Emails" page.
model SentEmail {
  id      String   @id @default(cuid())
  to      String
  subject String
  status  String // "SENT" | "SKIPPED" | "FAILED"
  error   String?
  sentAt  DateTime @default(now())

  @@index([to])
  @@index([sentAt])
}

// Admin-editable subject/body for a small set of email types (see
// EMAIL_TEMPLATE_DEFS in src/lib/email-template-store.ts for the full
// registry). `type` is one of those registry keys (e.g.
// "PAYMENT_RECEIPT") — no row means the type still uses its hardcoded
// default, so this table only ever holds overrides, not every email type.
// `bodyHtml` may contain "{{mergeField}}" placeholders substituted at send
// time; some of those are opaque system-rendered blocks (e.g. the invoice's
// line-items table) rather than freely-editable text — see the registry.
model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Extended features (§13.4)
// ---------------------------------------------------------------------------

model Pupdate {
  id          String     @id @default(cuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dogId       String
  dog         Dog        @relation(fields: [dogId], references: [id])
  staffId     String
  mediaItemId String?
  mediaItem   MediaItem? @relation(fields: [mediaItemId], references: [id])
  note        String?
  createdAt   DateTime   @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  customerId           String
  customer             User      @relation(fields: [customerId], references: [id])
  serviceId            String
  service              Service   @relation(fields: [serviceId], references: [id])
  dogId                String
  dog                  Dog       @relation(fields: [dogId], references: [id])
  weekdays             String
  slot                 String
  stripeSubscriptionId String?   @unique
  status               String
  pausedUntil          DateTime?
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  customerId     String
  customer       User           @relation(fields: [customerId], references: [id])
  serviceId      String
  service        Service        @relation(fields: [serviceId], references: [id])
  dogId          String
  dog            Dog            @relation(fields: [dogId], references: [id])
  date           DateTime
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  status         WaitlistStatus @default(WAITING)
  offerExpiresAt DateTime?
  reason         String?
}

model TrialVisit {
  id          String        @id @default(cuid())
  dogId       String
  dog         Dog           @relation(fields: [dogId], references: [id])
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])
  outcome     TrialOutcome?
  notes       String?
  completedAt DateTime?
  // How long a PASSED evaluation remains valid before a dog needs
  // re-assessing. Optional — staff set it alongside the outcome.
  validUntil  DateTime?
}

model Review {
  id         String       @id @default(cuid())
  customerId String
  customer   User         @relation(fields: [customerId], references: [id])
  // Null for a general review of the overall experience, not tied to one
  // stay — see submitGeneralReview in src/app/portal/reviews/actions.ts.
  bookingId  String?      @unique
  booking    Booking?     @relation(fields: [bookingId], references: [id])
  rating     Int
  text       String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

model Voucher {
  id             String    @id @default(cuid())
  code           String    @unique
  amountPence    Int
  remainingPence Int
  purchaserId    String?
  purchaser      User?     @relation("VoucherPurchaser", fields: [purchaserId], references: [id])
  recipientEmail String?
  expiresAt      DateTime?
  status         String
}

model CreditLedger {
  id          String   @id @default(cuid())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  amountPence Int
  reason      String
  bookingId   String?
  createdAt   DateTime @default(now())
}

model PriceRule {
  id                 String   @id @default(cuid())
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id])
  startDate          DateTime
  endDate            DateTime
  multiplier         Float?
  overridePricePence Int?
  minNights          Int?
  label              String
}

model DogFlag {
  id    String      @id @default(cuid())
  dogId String
  dog   Dog         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type  DogFlagType
  notes String?
}

model Agreement {
  id          String   @id @default(cuid())
  version     String
  // Legacy versions (before the admin agreement page moved to PDF uploads)
  // held the full terms as rich text here — kept nullable rather than
  // dropped so those old rows (and any SignedAgreement pointing at them)
  // don't lose their content. Every version published going forward leaves
  // this null and uses documentUrl instead.
  text        String?
  // Public R2 URL of the uploaded PDF — the actual terms document shown to
  // (and agreed to by) customers. Required for every version published via
  // publishAgreement; nullable here only for the same legacy-row reason as
  // text above.
  documentUrl String?
  publishedAt DateTime @default(now())
  active      Boolean  @default(true)

  signedAgreements SignedAgreement[]
}

model SignedAgreement {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id])
  signedName  String
  signedAt    DateTime  @default(now())
  ipAddress   String
  pdfUrl      String?
}

model NotificationPreference {
  customerId String              @id
  customer   User                @relation(fields: [customerId], references: [id])
  channel    NotificationChannel @default(EMAIL)
  perType    String?
}

model MessageLog {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  channel    String
  type       String
  payload    String?
  sentAt     DateTime @default(now())
  status     String
}
