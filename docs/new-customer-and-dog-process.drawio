<mxfile host="app.diagrams.net">
  <diagram name="New Customer and Dog" id="new-customer-dog">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Entry -->
        <mxCell id="s1" value="A new customer (with a dog) needs&#10;to be added to the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="30" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- Path headers -->
        <mxCell id="l0h" value="Path 1: customer self-service (via the website)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r0h" value="Path 2: admin quick-add (during a manual / phone booking)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Left column: self-service ===== -->
        <mxCell id="l1" value="Customer opens /register and fills in&#10;name, email, password, phone, address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="Email already registered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2a" value="Show error:&#10;&quot;account already exists&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="270" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="User created&#10;role = CUSTOMER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="Audit log: CREATE_CUSTOMER&#10;(self-registered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="Welcome email sent (best-effort)&#10;&#8212; links to /portal/dogs/new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="Customer auto-signed in&#10;&#8594; redirected to /portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l7" value="Customer opens&#10;/portal/dogs/new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l8" value="Fills in dog form: name, breed&#10;required; DOB, sex, size, weight,&#10;notes, photo optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l9" value="Fields valid?&#10;(e.g. age &#8804; 18yrs, weight &#8804; 200kg)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="840" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l9a" value="Show field errors&#10;&#8212; stays on the form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="860" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l10" value="Dog created, owned by the&#10;customer; photo uploaded&#10;to storage if provided" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
