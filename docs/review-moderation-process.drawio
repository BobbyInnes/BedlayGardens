<mxfile host="app.diagrams.net">
  <diagram name="Review Submission and Moderation" id="review-moderation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Entry -->
        <mxCell id="c1" value="Customer logs in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Opens Portal &#8594; Reviews&#10;(/portal/reviews)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="320" height="50" as="geometry" />
        </mxCell>

        <!-- Left path: stay-specific review -->
        <mxCell id="l1h" value="Path 1: review a specific stay" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="Booking status = CHECKED_OUT&#10;and has no review yet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="No &#8594; not eligible.&#10;Booking doesn't appear under&#10;&quot;Leave a review&quot; until it's&#10;checked out and unreviewed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="Yes &#8594; booking appears under&#10;&quot;Leave a review&quot; with a star&#10;rating (1&#8211;5) + optional text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="Customer submits&#10;(one-time &#8212; can't edit or&#10;resubmit for that stay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Right path: general review -->
        <mxCell id="r1h" value="Path 2: general &quot;overall experience&quot; review" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="200" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Always available on&#10;/portal/reviews &#8212; no booking&#10;or completed stay required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Does the customer already&#10;have a general review?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="940" y="340" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="No &#8594; fill in rating +&#10;optional text &#8594; new&#10;review created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Yes &#8594; edit rating/text &#8594;&#10;existing review updated&#10;(status resets to PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1080" y="480" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="Customer submits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="940" y="600" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Merge -->
        <mxCell id="m" value="Review saved / updated in DB&#10;status = PENDING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Admin moderation (unchanged logic, shifted down) -->
        <mxCell id="n3" value="Admin logs in and opens&#10;Admin &#8594; Reviews (/admin/reviews)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="800" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&quot;Awaiting moderation&quot; list&#10;(oldest pending first)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="900" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Admin decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="1000" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Click &quot;Approve&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="1130" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Click &quot;Reject&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="840" y="1130" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="status = APPROVED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="1210" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="status = REJECTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="1210" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Audit log entry written&#10;(MODERATE_REVIEW)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="1290" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Audit log entry written&#10;(MODERATE_REVIEW)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="1290" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Page cache revalidated&#10;(/admin/reviews and /)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="1370" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Page cache revalidated&#10;(/admin/reviews)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="1370" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Eligible for public homepage&#10;&quot;Recent Reviews&quot; section&#10;(newest 6 approved shown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="1450" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Stays hidden from&#10;the public site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="860" y="1450" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Shown in admin &quot;Recent decisions&quot; list&#10;(last 30 approved/rejected reviews)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="1560" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- edges: entry -->
        <mxCell id="e_c1c2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c2l2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c2r2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- edges: left path -->
        <mxCell id="e_l2l3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_l2l4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l2" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_l4l5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_l5m" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l5" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- edges: right path -->
        <mxCell id="e_r2r3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r3r4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r3r5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r3" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r4r6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r4" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r5r6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r6m" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r6" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- edges: moderation (same logic as before) -->
        <mxCell id="e_mn3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="m" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
